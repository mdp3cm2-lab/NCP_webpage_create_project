DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use the canonical HTTPS URL.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.ncptokyo\.net$ [NC]
  RewriteRule ^ https://ncptokyo.net%{REQUEST_URI} [R=301,L,NE]

  # Disable legacy WordPress entry points after the static site is installed.
  RewriteRule ^(?:wp-admin|wp-includes)(?:/|$) - [R=404,L]
  RewriteRule \.php$ - [R=404,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; frame-src https://www.instagram.com https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<FilesMatch "^(?:\.env|\.git|wp-config\.php|php_error_log|error_log)$">
  Require all denied
</FilesMatch>
